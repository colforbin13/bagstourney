// src/environments/environment.ts.example
// Example Angular environment file. Copy to src/environments/environment.ts and adjust as needed.

export const environment = {
  production: false,
  // Base URL for API. For local dev with the PHP built-in server
  // (php -S localhost:8080 -t api): http://localhost:8080
  // Production serves the API at '/api' (see environment.prod.ts).
  apiUrl: 'http://localhost:8080',
  // Path the app is served under; '/' for the domain root.
  baseHref: '/',
};
