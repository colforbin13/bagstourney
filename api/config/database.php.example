<?php
// api/config/database.php.example
// Example database config — DO NOT commit real credentials. Copy this file to api/config/database.php
// and fill with your environment values, or set the environment variables described below.

/*
Option A (recommended): use environment variables (example for Apache/NGINX):

export BB_DB_HOST="127.0.0.1:3306"
export BB_DB_NAME="beanbag_tournament"
export BB_DB_USER="your_db_user"
export BB_DB_PASS="your_db_password"
export BB_JWT_SECRET="a_long_random_string_here"
export BB_POSTMARK_TOKEN="your_postmark_server_api_token"
export BB_POSTMARK_FROM="notifications@yourdomain.example"
export BB_POSTMARK_MESSAGE_STREAM="outbound"
export BB_APP_PUBLIC_URL="https://yourdomain.example/bags"
export BB_NOTIFICATION_TOKEN_SECRET="a_long_random_string_here"
export BB_POSTMARK_WEBHOOK_USER="postmark"
export BB_POSTMARK_WEBHOOK_PASS="a_long_random_string_here"

Option B (development): copy this file and set values directly (not recommended for production).
*/

// Placeholder values — replace when creating api/config/database.php locally
$DB_HOST = '127.0.0.1:3306';
$DB_NAME = 'beanbag_tournament';
$DB_USER = 'dbuser';
$DB_PASS = 'your_db_password_here';
$JWT_SECRET = 'replace_with_a_secure_random_value';

// Postmark (score-notification emails — see FEATURE_TRACKER.md item 1). Leave the token
// blank to disable sending; the worker script logs and skips instead of failing.
$POSTMARK_API_TOKEN = 'your_postmark_server_api_token';
$POSTMARK_FROM_EMAIL = 'notifications@yourdomain.example';
$POSTMARK_MESSAGE_STREAM = 'outbound';
// Base URL used to build links (bracket view, confirm/unsubscribe) inside emails.
$APP_PUBLIC_URL = 'https://yourdomain.example/bags';
// Secret used to derive deterministic per-participant "manage my preferences" links
// (HMAC — see api/middleware/auth.php::notificationManageToken()). No token is stored;
// changing this secret invalidates every previously issued manage/unsubscribe link.
$NOTIFICATION_TOKEN_SECRET = 'replace_with_a_secure_random_value';
// HTTP Basic Auth credentials for the Postmark bounce/spam-complaint webhook endpoints —
// set these same values in Postmark's webhook URL configuration (https://user:pass@host/...).
$POSTMARK_WEBHOOK_USER = 'postmark';
$POSTMARK_WEBHOOK_PASS = 'replace_with_a_secure_random_value';

// TTL for JWT in seconds (default 8 hours)
define('JWT_EXPIRY', 3600 * 8);

// When using this example file directly, define constants expected by the app
define('DB_HOST', $DB_HOST);
define('DB_NAME', $DB_NAME);
define('DB_USER', $DB_USER);
define('DB_PASS', $DB_PASS);
define('JWT_SECRET', $JWT_SECRET);
define('POSTMARK_API_TOKEN', $POSTMARK_API_TOKEN);
define('POSTMARK_FROM_EMAIL', $POSTMARK_FROM_EMAIL);
define('POSTMARK_MESSAGE_STREAM', $POSTMARK_MESSAGE_STREAM);
define('APP_PUBLIC_URL', $APP_PUBLIC_URL);
define('NOTIFICATION_TOKEN_SECRET', $NOTIFICATION_TOKEN_SECRET);
define('POSTMARK_WEBHOOK_USER', $POSTMARK_WEBHOOK_USER);
define('POSTMARK_WEBHOOK_PASS', $POSTMARK_WEBHOOK_PASS);

function getDB(): PDO {
    static $pdo = null;
    if ($pdo === null) {
        $dsn = "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=utf8mb4";
        $pdo = new PDO($dsn, DB_USER, DB_PASS, [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
        ]);
    }
    return $pdo;
}

?>