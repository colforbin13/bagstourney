<?php
// api/config/database.php.example
// Example database config — DO NOT commit real credentials. Copy this file to api/config/database.php
// and fill with your environment values, or set the environment variables described below.

/*
Option A (recommended): use environment variables (example for Apache/NGINX):

export BB_DB_HOST="127.0.0.1:3306"
export BB_DB_NAME="beanbag_tournament"
export BB_DB_USER="your_db_user"
export BB_DB_PASS="your_db_password"
export BB_JWT_SECRET="a_long_random_string_here"
export BB_POSTMARK_TOKEN="your_postmark_server_api_token"
export BB_POSTMARK_FROM="notifications@yourdomain.example"
export BB_POSTMARK_MESSAGE_STREAM="outbound"
export BB_APP_PUBLIC_URL="https://yourdomain.example/bags"
export BB_NOTIFICATION_TOKEN_SECRET="a_long_random_string_here"
export BB_POSTMARK_WEBHOOK_USER="postmark"
export BB_POSTMARK_WEBHOOK_PASS="a_long_random_string_here"
export BB_BREVO_API_KEY="your_brevo_v3_api_key"
export BB_BREVO_FROM="notifications@yourdomain.example"
export BB_BREVO_FROM_NAME="Your App Name"
export BB_BREVO_WEBHOOK_USER="brevo"
export BB_BREVO_WEBHOOK_PASS="a_long_random_string_here"
export BB_STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
export BB_STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"
export BB_STRIPE_MANAGED_PAYMENTS="true"
export BB_STRIPE_API_VERSION=""
export BB_STRIPE_PRICE_TOURNAMENT_UNLOCK="price_your_one_time_unlock_price_id"
export BB_STRIPE_PRICE_SUBSCRIPTION_MONTHLY="price_your_monthly_price_id"
export BB_STRIPE_PRICE_SUBSCRIPTION_ANNUAL="price_your_annual_price_id"
export BB_STRIPE_BILLING_ENABLED="true"
export BB_NOTIFY_MATCH_COMPLETED_ENABLED="true"
export BB_NOTIFY_ROUND_COMPLETED_ENABLED="true"
export BB_NOTIFY_TOURNAMENT_FINALIZED_ENABLED="true"

Option B (development): copy this file and set values directly (not recommended for production).
*/

// Placeholder values — replace when creating api/config/database.php locally
$DB_HOST = '127.0.0.1:3306';
$DB_NAME = 'beanbag_tournament';
$DB_USER = 'dbuser';
$DB_PASS = 'your_db_password_here';
$JWT_SECRET = 'replace_with_a_secure_random_value';

// Postmark (score-notification emails — see FEATURE_TRACKER.md item 1). Leave the token
// blank to disable sending; the worker script logs and skips instead of failing.
$POSTMARK_API_TOKEN = 'your_postmark_server_api_token';
$POSTMARK_FROM_EMAIL = 'notifications@yourdomain.example';
$POSTMARK_MESSAGE_STREAM = 'outbound';
// Base URL used to build links (bracket view, confirm/unsubscribe) inside emails.
$APP_PUBLIC_URL = 'https://yourdomain.example/bags';
// Secret used to derive deterministic per-participant "manage my preferences" links
// (HMAC — see api/middleware/auth.php::notificationManageToken()). No token is stored;
// changing this secret invalidates every previously issued manage/unsubscribe link.
$NOTIFICATION_TOKEN_SECRET = 'replace_with_a_secure_random_value';
// HTTP Basic Auth credentials for the Postmark bounce/spam-complaint webhook endpoints —
// set these same values in Postmark's webhook URL configuration (https://user:pass@host/...).
$POSTMARK_WEBHOOK_USER = 'postmark';
$POSTMARK_WEBHOOK_PASS = 'replace_with_a_secure_random_value';

// Brevo — bulk notification mail only (api/scripts/send_notifications.php). Auth mail
// (AuthController::register) stays on Postmark above so a bulk-send quota exhaustion can
// never block account registration. Leave the key blank to disable bulk sending.
$BREVO_API_KEY = 'your_brevo_v3_api_key';
$BREVO_FROM_EMAIL = 'notifications@yourdomain.example';
$BREVO_FROM_NAME = 'Your App Name';
// HTTP Basic Auth for Brevo's event webhook — Brevo takes these embedded in the webhook
// URL (https://user:pass@host/...), same as Postmark. Kept separate from the Postmark
// webhook credentials so either provider can be rotated independently.
$BREVO_WEBHOOK_USER = 'brevo';
$BREVO_WEBHOOK_PASS = 'replace_with_a_secure_random_value';
// Stripe billing — the organizer pays the platform (FEATURE_TRACKER.md items 12/13). This
// is a single-merchant hosted Checkout integration; participant registration fees (items
// 10/11) are a separate Stripe Connect build and are not this.
//
// Leave every value blank to disable billing entirely: the paid flags stay super-admin-only
// exactly as they are today and the frontend hides the upgrade buttons, so an unconfigured
// install behaves as if this feature does not exist rather than offering a broken checkout.
// See docs/stripe-setup.md for the dashboard walkthrough.
$STRIPE_SECRET_KEY = 'sk_test_your_stripe_secret_key';
// Developers > Webhooks > your endpoint > Signing secret. Register the endpoint at
// https://yourdomain.example/api/billing/webhook — note /api, not /bags/api.
$STRIPE_WEBHOOK_SECRET = 'whsec_your_webhook_signing_secret';
// Managed Payments — Stripe acts as merchant of record, handling sales tax/VAT/GST,
// fraud, disputes and buyer support for 3.5% above standard processing. Requires the
// Managed Payments terms accepted in the dashboard, the feature enabled, and an
// eligible product tax code on every product. See docs/stripe-setup.md.
$STRIPE_MANAGED_PAYMENTS = true;
// Blank uses the Stripe account's default API version, which is what you want —
// except that Managed Payments needs 2025-03-31.basil or later.
$STRIPE_API_VERSION = '';
// Price IDs from the Stripe product catalogue, not amounts — the price of record lives in
// Stripe so changing what you charge is a dashboard edit rather than a deploy.
$STRIPE_PRICE_TOURNAMENT_UNLOCK = 'price_your_one_time_unlock_price_id';
$STRIPE_PRICE_SUBSCRIPTION_MONTHLY = 'price_your_monthly_price_id';
$STRIPE_PRICE_SUBSCRIPTION_ANNUAL = 'price_your_annual_price_id';
// Kill switch independent of the keys: false stops new checkouts without removing
// credentials. Plans already paid for keep working.
$STRIPE_BILLING_ENABLED = true;

// Per-category kill switches — e.g. to stay under a Postmark plan's monthly send limit.
// Checked at both enqueue time (MatchController) and send time (send_notifications.php).
$NOTIFY_MATCH_COMPLETED_ENABLED = true;
$NOTIFY_ROUND_COMPLETED_ENABLED = true;
$NOTIFY_TOURNAMENT_FINALIZED_ENABLED = true;

// TTL for JWT in seconds (default 8 hours)
define('JWT_EXPIRY', 3600 * 8);

// When using this example file directly, define constants expected by the app
define('DB_HOST', $DB_HOST);
define('DB_NAME', $DB_NAME);
define('DB_USER', $DB_USER);
define('DB_PASS', $DB_PASS);
define('JWT_SECRET', $JWT_SECRET);
define('POSTMARK_API_TOKEN', $POSTMARK_API_TOKEN);
define('POSTMARK_FROM_EMAIL', $POSTMARK_FROM_EMAIL);
define('POSTMARK_MESSAGE_STREAM', $POSTMARK_MESSAGE_STREAM);
define('APP_PUBLIC_URL', $APP_PUBLIC_URL);
define('NOTIFICATION_TOKEN_SECRET', $NOTIFICATION_TOKEN_SECRET);
define('POSTMARK_WEBHOOK_USER', $POSTMARK_WEBHOOK_USER);
define('POSTMARK_WEBHOOK_PASS', $POSTMARK_WEBHOOK_PASS);
define('BREVO_API_KEY', $BREVO_API_KEY);
define('BREVO_FROM_EMAIL', $BREVO_FROM_EMAIL);
define('BREVO_FROM_NAME', $BREVO_FROM_NAME);
define('BREVO_WEBHOOK_USER', $BREVO_WEBHOOK_USER);
define('BREVO_WEBHOOK_PASS', $BREVO_WEBHOOK_PASS);
define('STRIPE_SECRET_KEY', $STRIPE_SECRET_KEY);
define('STRIPE_WEBHOOK_SECRET', $STRIPE_WEBHOOK_SECRET);
define('STRIPE_MANAGED_PAYMENTS', $STRIPE_MANAGED_PAYMENTS);
define('STRIPE_API_VERSION', $STRIPE_API_VERSION);
define('STRIPE_PRICE_TOURNAMENT_UNLOCK', $STRIPE_PRICE_TOURNAMENT_UNLOCK);
define('STRIPE_PRICE_SUBSCRIPTION_MONTHLY', $STRIPE_PRICE_SUBSCRIPTION_MONTHLY);
define('STRIPE_PRICE_SUBSCRIPTION_ANNUAL', $STRIPE_PRICE_SUBSCRIPTION_ANNUAL);
define('STRIPE_BILLING_ENABLED', $STRIPE_BILLING_ENABLED);
define('NOTIFY_MATCH_COMPLETED_ENABLED', $NOTIFY_MATCH_COMPLETED_ENABLED);
define('NOTIFY_ROUND_COMPLETED_ENABLED', $NOTIFY_ROUND_COMPLETED_ENABLED);
define('NOTIFY_TOURNAMENT_FINALIZED_ENABLED', $NOTIFY_TOURNAMENT_FINALIZED_ENABLED);

function getDB(): PDO {
    static $pdo = null;
    if ($pdo === null) {
        $dsn = "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=utf8mb4";
        $pdo = new PDO($dsn, DB_USER, DB_PASS, [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
        ]);
    }
    return $pdo;
}

?>